{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/resume",
      "destination": "https://drive.google.com/file/d/1VRdzFKmG1N1Fzd-4t-3sZSiC8ddpDoil/view?usp=sharing",
      "permanent": true
    },
    {
      "source": "/resume-ai",
      "destination": "https://drive.google.com/file/d/1DkNV2i9SAwbmCRSegEMpbnTiIPr7dI6N/view?usp=sharing",
      "permanent": true
    }
  ]
}
